{
    "name": "lighthouse/dns-interception",
    "description": "灯塔DNS拦截响应平台 - 域名过期与违规拦截服务",
    "version": "1.0.0",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.0",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-json": "*",
        "ext-curl": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "logto/sdk": "^0.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "autoload": {
        "psr-4": {
            "Core\\": "core/"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "mkdir -p storage/logs",
            "chmod -R 755 storage"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
